<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Aspire.Azure.Storage.Blobs" />
    <PackageReference Include="Aspire.Microsoft.Azure.Cosmos" />
    <PackageReference Include="Azure.Communication.Email" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" />
    <PackageReference Include="Stripe.net" />
  </ItemGroup>

  <ItemGroup>
    <!-- The database and container definitions, shared by the AppHost and the API. -->
    <Compile Include="..\Shared\DataModelSchema.cs" Link="Shared\DataModelSchema.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Escribot.ServiceDefaults\Escribot.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The curated prompt bank, seeded into the database at startup. -->
    <EmbeddedResource Include="Data\Seed\curated-prompts.json" />
    <Content Remove="Data\Seed\curated-prompts.json" />
    <!-- The Vault items every new account starts with. -->
    <EmbeddedResource Include="Data\Seed\starter-vault.json" />
    <Content Remove="Data\Seed\starter-vault.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Development-only settings stay out of the published output and the Docker image. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Escribot.Api.Tests" />
  </ItemGroup>

</Project>
