# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# typescript
*.tsbuildinfo

# ------------------------------------------------------------------------------
# .NET / Aspire / Azure
# ------------------------------------------------------------------------------

# build output
[Bb]in/
[Oo]bj/
/artifacts/
/publish/
TestResults/
*.trx

# IDE and per-user files
.vs/
.idea/
*.user
*.suo
*.DotSettings.user

# local settings: secrets belong in .NET user secrets or Aspire parameters,
# never in a settings file inside the repository
appsettings.Local.json
appsettings.*.Local.json
local.settings.json
secrets.json
*.pfx
*.p12
*.key

# publish profiles can embed deployment credentials
*.pubxml
*.pubxml.user
*.publishsettings
[Pp]roperties/[Pp]ublish[Pp]rofiles/

# Azure CLI, azd and Aspire deployment state (subscription, tenant and resource ids)
.azure/
.aspire/
aspire-manifest.json
*.azureauth

# emulator data (Cosmos DB emulator, Azurite)
__azurite__/
__blobstorage__/
__queuestorage__/
azurite/
__azurite_db_*.json
.cosmos-emulator/

# front-end build output (Vite)
dist/

# the browser app copied next to the API to serve it without the Vite dev server
server/src/Escribot.Api/wwwroot/
