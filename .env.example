# ==============================================================================
# FluentEscritor — Environment Configuration
# ==============================================================================

# 1. Authentication & Encryption Gate (Required on Vercel)
# Protects your workspace & AI quota across devices via an HMAC-signed cookie.
# In local dev without APP_PASSCODE set, passcode gate is optional/unlocked by default
# unless you set APP_PASSCODE here.
APP_PASSCODE=
# Optional 32+ char secret for cookie signing & AES-256-GCM API key encryption
# (automatically derived from APP_PASSCODE if omitted)
APP_SECRET=

# 2. Database (Turso LibSQL in production; local SQLite file automatically in dev)
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=

# 3. AI Provider Keys (OpenRouter is default; can also be configured in encrypted Settings UI)
OPENROUTER_API_KEY=
# Optional override base URL (defaults to https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional direct provider keys selectable in Settings
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
