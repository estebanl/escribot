# ==============================================================================
# FluentEscritor — Environment Configuration
# ==============================================================================

# 1. Accounts & sessions (Better Auth)
# Required in production: 32+ char random secret used to sign session cookies.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the deployment (e.g. https://fluentescritor.example.com).
BETTER_AUTH_URL=http://localhost:3000

# Upgrading a single-user install: the account that signs up with this email
# inherits all data created before multi-user support (essays, Vault, settings).
OWNER_EMAIL=
# Optional comma-separated allowlist. Leave empty to let anyone sign up.
ALLOWED_SIGNUP_EMAILS=

# Optional "Continue with Google". Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional transactional email (Resend). When both are set, new accounts must
# verify their email and password-reset links are emailed. When unset, links
# are printed to the server log and email verification is skipped.
RESEND_API_KEY=
EMAIL_FROM=

# Secret used for AES-256-GCM encryption of API keys saved in Settings.
# Existing installs: keep the value you already use (or keep APP_PASSCODE set
# if you never defined APP_SECRET), otherwise saved keys must be re-entered.
APP_SECRET=

# 2. Database (Turso LibSQL in production; local SQLite file automatically in dev)
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=

# 3. AI Provider Keys (OpenRouter is default; can also be configured in encrypted Settings UI)
OPENROUTER_API_KEY=
# Optional override base URL (defaults to https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional direct provider keys selectable in Settings
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
