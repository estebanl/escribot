# ==============================================================================
# FluentEscritor — settings reference
# ==============================================================================
# The API reads these as environment variables. Nothing reads this file: locally,
# set values with .NET user secrets (see "Settings and secrets" in the README);
# in Azure, the deploy workflow passes them from the GitHub "production"
# environment and stores the secrets in Key Vault.

# 1. Required
# At least 32 random characters (openssl rand -hex 32). Encrypts the API keys
# users save in Settings; never change it. Generated by the AppHost locally.
App__EncryptionSecret=
# Public HTTPS address of the deployment, for email links and Stripe redirects.
App__PublicUrl=
# Supplied by the AppHost locally and by the deployment in Azure.
ConnectionStrings__cosmos=
ConnectionStrings__blobs=
# Only behind a proxy such as the Container Apps ingress.
App__TrustForwardedHeaders=

# 2. Accounts
# The owner account: unlimited AI use and admin. Counts only once verified.
OWNER_EMAIL=
# Optional comma-separated allowlist. Leave empty to let anyone sign up.
ALLOWED_SIGNUP_EMAILS=
# Extra admins for /admin (comma-separated, must be verified).
ADMIN_EMAILS=
# Optional "Continue with Google". Redirect URI: <App__PublicUrl>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 3. Email (Azure Communication Services). Strongly recommended in production:
# without it, password reset is disabled and new accounts are not verified.
# Outside production, links are printed to the console instead.
AZURE_COMMUNICATION_CONNECTION_STRING=
EMAIL_FROM=

# 4. Platform AI keys, used for every account that has not saved its own key,
# metered by the plan quotas in server/src/FluentEscritor.Api/Common/Plans.cs.
# Optional ceiling on graded essays + coaching requests per UTC day across ALL
# Free accounts on platform keys. e.g. 500
FREE_PLAN_DAILY_AI_CAP=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 5. Billing (Stripe). Leave empty to run without paid plans.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Signing secret of the webhook endpoint <App__PublicUrl>/api/stripe/webhook,
# subscribed to customer.subscription.created/updated/deleted/paused/resumed.
STRIPE_WEBHOOK_SECRET=

# 6. Legal pages. Shown on /terms and /privacy. Set these before launch.
SITE_OPERATOR=
SUPPORT_EMAIL=
SITE_JURISDICTION=
