# ==============================================================================
# FluentEscritor — Environment Configuration
# ==============================================================================

# 1. Accounts & sessions (Better Auth)
# Required in production: 32+ char random secret used to sign session cookies.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the deployment (e.g. https://fluentescritor.example.com).
BETTER_AUTH_URL=http://localhost:3000

# The owner account: unlimited AI use, and on an upgraded single-user install it
# inherits all data created before multi-user support. Only takes effect once
# this address is verified (email link, Google sign-in, or manually in the DB).
OWNER_EMAIL=
# Optional comma-separated allowlist. Leave empty to let anyone sign up.
ALLOWED_SIGNUP_EMAILS=

# Optional "Continue with Google". Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email (Resend). Strongly recommended in production: new accounts
# verify their email and password-reset links are emailed. Without it, in
# production: password reset is disabled, and Free accounts can only use the
# platform AI keys if they signed in with Google or are listed in
# ALLOWED_SIGNUP_EMAILS. In development, links are printed to the console.
RESEND_API_KEY=
EMAIL_FROM=

# Required in production: secret used for AES-256-GCM encryption of the API keys
# users save in Settings. Use a long random value and never change it.
# Keys saved by an older single-user install (encrypted with APP_PASSCODE) are
# still readable while APP_PASSCODE stays set, and are re-encrypted on next save.
APP_SECRET=

# 2. Database (Turso LibSQL in production; local SQLite file automatically in dev)
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=

# 3. Platform AI keys. Used for every account that has not saved its own key in
# Settings, metered per user by the plan quotas in src/lib/plans.ts
# (the OWNER_EMAIL account is unlimited).
# Optional ceiling on graded essays + coaching requests per UTC day across ALL
# Free accounts on platform keys, as a hard bound on Free-tier spend. e.g. 500
FREE_PLAN_DAILY_AI_CAP=
OPENROUTER_API_KEY=
# Optional override base URL (defaults to https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional direct provider keys selectable in Settings
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 4. Billing (Stripe). Leave empty to run without paid plans.
# Create a "Pro" product with a recurring monthly price (and optionally a
# yearly one) in the Stripe dashboard and paste the price ids here.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Signing secret of the webhook endpoint <BETTER_AUTH_URL>/api/stripe/webhook,
# subscribed to customer.subscription.created/updated/deleted/paused/resumed.
STRIPE_WEBHOOK_SECRET=

# 5. Site, admin and storage
# Shown on /terms and /privacy. Set these before launch.
SITE_OPERATOR=
SUPPORT_EMAIL=
SITE_JURISDICTION=
# Extra admins for /admin (comma-separated, must be verified). The verified
# OWNER_EMAIL account is always an admin.
ADMIN_EMAILS=
# Vercel Blob read-write token for uploaded chart images (private store).
# Without it, images are stored in the database, which is fine for development.
BLOB_READ_WRITE_TOKEN=
